{
  "name": "@ravileal/ui",
  "version": "0.1.1",
  "description": "Reusable React UI primitives with themeable CSS variables",
  "type": "module",
  "license": "ISC",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravileal/ui.git"
  },
  "bugs": {
    "url": "https://github.com/ravileal/ui/issues"
  },
  "homepage": "https://github.com/ravileal/ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node scripts/copy-styles.mjs",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src .storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "semantic-release",
    "pack:check": "pnpm build && npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/test": "^8.6.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.15.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semantic-release": "^25.0.9",
    "storybook": "^8.6.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
